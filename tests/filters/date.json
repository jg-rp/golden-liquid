{
  "tests": [
    {
      "name": "well formed string",
      "template": "{{ 'March 14, 2016' | date: '%b %d, %y' }}",
      "result": "Mar 14, 16",
      "tags": [
        "date filter"
      ]
    },
    {
      "name": "too many arguments",
      "template": "{{ 'March 14, 2016' | date: '%b %d, %y', 'foo' }}",
      "invalid": true,
      "tags": [
        "date filter"
      ]
    },
    {
      "name": "undefined left value",
      "template": "{{ nosuchthing | date: '%b %d, %y' }}",
      "result": "",
      "tags": [
        "date filter"
      ]
    },
    {
      "name": "missing argument",
      "template": "{{ 'March 14, 2016' | date }}",
      "invalid": true,
      "tags": [
        "date filter"
      ]
    },
    {
      "name": "undefined argument",
      "template": "{{ 'March 14, 2016' | date: nosuchthing }}",
      "result": "March 14, 2016",
      "tags": [
        "date filter"
      ]
    },
    {
      "name": "literal percent",
      "template": "{{ 'March 14, 2016' | date: '%%%b %d, %y' }}",
      "result": "%Mar 14, 16",
      "tags": [
        "date filter"
      ]
    },
    {
      "name": "timestamp integer",
      "template": "{{ 1152098955 | date: '%m/%d/%Y' }}",
      "result": "07/05/2006",
      "tags": [
        "date filter"
      ]
    },
    {
      "name": "timestamp string",
      "template": "{{ '1152098955' | date: '%m/%d/%Y' }}",
      "result": "07/05/2006",
      "tags": [
        "date filter"
      ]
    },
    {
      "name": "negative timestamp string",
      "template": "{{ '-1152098955' | date: '%m/%d/%Y' }}",
      "result": "-1152098955",
      "tags": [
        "date filter"
      ]
    },
    {
      "name": "seconds since epoch format directive",
      "template": "{{ 'March 14, 2016' | date: '%s' }}",
      "result": "1457913600",
      "tags": [
        "date filter",
        "utc"
      ]
    },
    {
      "name": "no padding flag on zero",
      "template": "{{ '2024-01-01 09:00:00 +00:00' | date: '%-M %-S %-H' }}",
      "result": "0 0 9",
      "tags": [
        "date filter",
        "utc"
      ]
    },
    {
      "name": "blank padded hours",
      "template": "{{ '2024-01-01 09:00:00 +00:00' | date: '%k|%l' }}",
      "result": " 9| 9",
      "tags": [
        "date filter",
        "utc"
      ]
    },
    {
      "name": "fractional seconds",
      "template": "{{ '2024-01-01 00:00:00.005 +00:00' | date: '%N %3N %L' }}",
      "result": "005000000 005 005",
      "tags": [
        "date filter",
        "utc"
      ]
    },
    {
      "name": "iso week date in the next year",
      "template": "{{ '2024-12-30 12:00:00 +00:00' | date: '%V %G %g' }}",
      "result": "01 2025 25",
      "tags": [
        "date filter",
        "utc"
      ]
    },
    {
      "name": "iso week date in the previous year",
      "template": "{{ '2021-01-01 12:00:00 +00:00' | date: '%V %G %g' }}",
      "result": "53 2020 20",
      "tags": [
        "date filter",
        "utc"
      ]
    }
  ]
}