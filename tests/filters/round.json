{
  "tests": [
    {
      "name": "float round down",
      "template": "{{ 5.1 | round }}",
      "result": "5",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "float round up",
      "template": "{{ 5.6 | round }}",
      "result": "6",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "float as a string",
      "template": "{{ \"5.6\" | round }}",
      "result": "6",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "string argument",
      "template": "{{ 5.666 | round: \"1\" }}",
      "result": "5.7",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "decimal places",
      "template": "{{ \"5.666666\" | round: 2 }}",
      "result": "5.67",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "integer",
      "template": "{{ 5 | round }}",
      "result": "5",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "too many args",
      "template": "{{ 5 | round: 1, 2 }}",
      "invalid": true,
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "undefined left value",
      "template": "{{ nosuchthing | round: 2 }}",
      "result": "0",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "undefined argument",
      "template": "{{ 5.666 | round: nosuchthing }}",
      "result": "6",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "argument is a string",
      "template": "{{ 5.666 | round: 'foo' }}",
      "result": "6",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "argument is a string representation of an integer",
      "template": "{{ 5.666 | round: '1' }}",
      "result": "5.7",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "argument is a string representation of zero",
      "template": "{{ 5.666 | round: '1' }}",
      "result": "5.7",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "argument is a negative",
      "template": "{{ 5.666 | round: -2 }}",
      "result": "0",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "argument is a float",
      "template": "{{ 5.666 | round: 1.2 }}",
      "result": "5.7",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "argument is a zero",
      "template": "{{ 5.666 | round: 0 }}",
      "result": "6",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "half rounds up",
      "template": "{{ 2.5 | round }}",
      "result": "3",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "half below one rounds up",
      "template": "{{ 0.5 | round }}",
      "result": "1",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "negative half rounds away from zero",
      "template": "{{ -2.5 | round }}",
      "result": "-3",
      "tags": [
        "round filter"
      ]
    },
    {
      "name": "half at decimal places",
      "template": "{{ 1.125 | round: 2 }}",
      "result": "1.13",
      "tags": [
        "round filter"
      ]
    }
  ]
}