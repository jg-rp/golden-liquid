{
  "tests": [
    {
      "name": "range literal concat filter left value",
      "template": "{{ (1..3) | concat: foo | join: '#' }}",
      "data": {
        "foo": [
          5,
          6,
          7
        ]
      },
      "result": "1#2#3#5#6#7",
      "tags": [
        "concat filter",
        "join filter"
      ]
    },
    {
      "name": "two arrays of strings",
      "template": "{{ a | concat: b | join: '#' }}",
      "data": {
        "a": [
          "a",
          "b"
        ],
        "b": [
          "c",
          "d"
        ]
      },
      "result": "a#b#c#d",
      "tags": [
        "concat filter",
        "join filter"
      ]
    },
    {
      "name": "missing argument is an error",
      "template": "{{ a | concat | join: '#' }}",
      "data": {
        "a": [
          "a",
          "b"
        ]
      },
      "invalid": true,
      "tags": [
        "concat filter",
        "join filter"
      ]
    },
    {
      "name": "non array-like argument is an error",
      "template": "{{ a | concat: b | join: '#' }}",
      "data": {
        "a": [
          "a",
          "b"
        ],
        "b": 5
      },
      "invalid": true,
      "tags": [
        "concat filter",
        "join filter"
      ]
    },
    {
      "name": "left value is not array-like",
      "template": "{{ a | concat: b | join: '#' }}",
      "data": {
        "a": "ab",
        "b": [
          "c",
          "d"
        ]
      },
      "result": "ab#c#d",
      "tags": [
        "concat filter",
        "join filter"
      ]
    },
    {
      "name": "left value contains non string",
      "template": "{{ a | concat: b | join: '#' }}",
      "data": {
        "a": [
          "a",
          "b",
          5
        ],
        "b": [
          "c",
          "d"
        ]
      },
      "result": "a#b#5#c#d",
      "tags": [
        "concat filter",
        "join filter"
      ]
    },
    {
      "name": "undefined left value",
      "template": "{{ nosuchthing | concat: b | join: '#' }}",
      "data": {
        "b": [
          "c",
          "d"
        ]
      },
      "result": "c#d",
      "tags": [
        "concat filter",
        "join filter"
      ]
    },
    {
      "name": "undefined argument is an error",
      "template": "{{ a | concat: nosuchthing | join: '#' }}",
      "data": {
        "a": [
          "a",
          "b"
        ]
      },
      "invalid": true,
      "tags": [
        "concat filter",
        "join filter"
      ]
    },
    {
      "name": "nested left value gets flattened",
      "template": "{{ a | concat: b | join: '#' }}",
      "data": {
        "a": [
          [
            "a",
            "x"
          ],
          [
            "b",
            [
              "y",
              [
                "z"
              ]
            ]
          ]
        ],
        "b": [
          "c",
          "d"
        ]
      },
      "result": "a#x#b#y#z#c#d",
      "tags": [
        "concat filter",
        "join filter"
      ]
    },
    {
      "name": "hashes are kept as items",
      "template": "{% assign x = a | concat: b %}{{ x | size }}:{% for h in x %}{{ h.k }} {% endfor %}",
      "data": {
        "a": [
          {
            "k": "a",
            "l": 1,
            "m": 2
          }
        ],
        "b": [
          {
            "k": "b"
          }
        ]
      },
      "result": "2:a b ",
      "tags": [
        "concat filter"
      ]
    },
    {
      "name": "nil items are kept",
      "template": "{% assign x = a | concat: b %}{{ x | size }}:{{ x | join: '#' }}",
      "data": {
        "a": [
          1,
          null,
          2
        ],
        "b": [
          null,
          3
        ]
      },
      "result": "5:1##2##3",
      "tags": [
        "concat filter",
        "join filter"
      ]
    }
  ]
}